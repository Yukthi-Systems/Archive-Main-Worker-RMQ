# Copy this file to .env and fill in real values for your environment:
#   cp .env.example .env
#
# .env is loaded automatically on startup (see internal/config) and is
# git-ignored, so real credentials never get committed. Values shown below
# are placeholders unless noted otherwise as an actual default.

# --- RabbitMQ settings ---
RB_HOST=localhost
RB_PORT=5672
RB_USERNAME=changeme
RB_PASSWD=changeme
RB_VHOST=/
RB_CONSUME_QUEUE=archive_processed_mails
RB_FAILED_QUEUE=dead_parser
RB_CONSUMER_TAG=main-consumer-1
RB_PREFETCH=100
RB_WORKER_COUNT=1
RB_BATCH_SIZE=100
RB_BATCH_FLUSH_TIMEOUT=1s
AMQPR_CON_DELAY=5s

# --- ClickHouse settings ---
CLICKHOUSE_ADDR=localhost:8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=changeme
CLICKHOUSE_DB=default

# --- Domain API settings ---
API_URL=https://api.example.com
API_KEY=changeme

# --- Archive storage server settings ---
# Authenticates requests to the storage server's archive-write endpoint
# (internal/client.APIClient.StoreMail). Must match the key the storage
# server expects.
ARCHIVE_API_KEY=changeme

# --- Caching settings ---
CACHE_TTL=3h
CACHE_CLEANUP_INTERVAL=5m

# --- Logging settings ---
LOG_FILE=./logs/app.log
LOG_MAX_SIZE_MB=50
LOG_MAX_BACKUPS=5
LOG_MAX_AGE_DAYS=14
LOG_COMPRESS=true
LOG_LEVEL=debug
LOG_CONSOLE=false
